  terminal   Terminal? @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  berth      Berth?    @relation(fields: [berthId], references: [id], onDelete: Restrict)
  zone       PortZone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  assignedBy User      @relation("AssignmentGranter", fields: [assignedById], references: [id], onDelete: Restrict)
  tasks      Task[]

  @@index([userId, status])
  @@index([portId, status])
  @@index([portId, berthId, status])
  @@map("user_assignments")
}

model TaskTemplate {
  id              Int          @id @default(autoincrement())
  code            String       @unique @db.VarChar(60)
  taskType        TaskType     @unique @map("task_type")
  titleTemplate   String       @map("title_template") @db.VarChar(200)
  description     String       @db.Text
  defaultPriority TaskPriority @default(MEDIUM) @map("default_priority")
  slaMinutes      Int          @default(240) @map("sla_minutes")
  sopReference    String?      @map("sop_reference") @db.VarChar(200)
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  checklistItems TaskTemplateChecklistItem[]
  tasks          Task[]

  @@map("task_templates")
}

model TaskTemplateChecklistItem {
  id                         Int              @id @default(autoincrement())
  templateId                 Int              @map("template_id")
  itemOrder                  Int              @map("item_order")
  code                       String           @db.VarChar(60)
  label                      String           @db.VarChar(255)
  isRequired                 Boolean          @default(true) @map("is_required")
  requiresAttachment         Boolean          @default(false) @map("requires_attachment")
  applicableVesselCategories VesselCategory[] @default([]) @map("applicable_vessel_categories")

  template TaskTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, code])
  @@index([templateId, itemOrder])
  @@map("task_template_checklist_items")
}

model Task {
  id                Int                 @id @default(autoincrement())
  taskNumber        String              @unique @map("task_number") @db.VarChar(60)
  taskType          TaskType            @map("task_type")
  templateId        Int?                @map("template_id")
  title             String              @db.VarChar(200)
  description       String              @db.Text
  sourceType        TaskSourceType      @map("source_type")
  sourceId          String?             @map("source_id") @db.VarChar(80)
  portId            Int                 @map("port_id")
  terminalId        Int?                @map("terminal_id")
  berthId           Int?                @map("berth_id")
  zoneId            Int?                @map("zone_id")
  visitId           Int?                @map("visit_id")
  assigneeId        Int?                @map("assignee_id")
  assignmentId      Int?                @map("assignment_id")
  createdById       Int?                @map("created_by_id")
  priority          TaskPriority        @default(MEDIUM)
  obligationDate    DateTime            @map("obligation_date") @db.Date
  dueDate           DateTime            @map("due_date")
  executionStatus   TaskExecutionStatus @default(NOT_STARTED) @map("execution_status")
  reviewStatus      TaskReviewStatus    @default(NOT_SUBMITTED) @map("review_status")
  isOverdue         Boolean             @default(false) @map("is_overdue")
  hasIssue          Boolean             @default(false) @map("has_issue")
  issueNotes        String?             @map("issue_notes") @db.Text
  notes             String?             @db.Text
  startedAt         DateTime?           @map("started_at")
  submittedAt       DateTime?           @map("submitted_at")
  adminReviewedById Int?                @map("admin_reviewed_by_id")
  adminReviewedAt   DateTime?           @map("admin_reviewed_at")
  adminReviewNotes  String?             @map("admin_review_notes") @db.Text
  headVerifiedById  Int?                @map("head_verified_by_id")
  headVerifiedAt    DateTime?           @map("head_verified_at")
  headVerifyNotes   String?             @map("head_verify_notes") @db.Text
  rejectionReason   String?             @map("rejection_reason") @db.Text
  completedAt       DateTime?           @map("completed_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  template        TaskTemplate?       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  port            Port                @relation(fields: [portId], references: [id], onDelete: Restrict)
  terminal        Terminal?           @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  berth           Berth?              @relation(fields: [berthId], references: [id], onDelete: Restrict)
  zone            PortZone?           @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  visit           ShipVisit?          @relation(fields: [visitId], references: [id], onDelete: Restrict)
  assignee        User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  assignment      UserAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  createdBy       User?               @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  adminReviewedBy User?               @relation("TaskAdminReviewer", fields: [adminReviewedById], references: [id], onDelete: Restrict)
  headVerifiedBy  User?               @relation("TaskHeadVerifier", fields: [headVerifiedById], references: [id], onDelete: Restrict)
  checklistItems  TaskChecklistItem[]
  attachments     TaskAttachment[]
  submissions     TaskSubmission[]
  reviews         TaskReview[]
  histories       TaskHistory[]

  @@index([portId, executionStatus, reviewStatus])
  @@index([portId, obligationDate, assigneeId])
  @@index([portId, berthId])
  @@index([portId, dueDate])
  @@index([sourceType, sourceId])
  @@map("tasks")
}

model TaskChecklistItem {
  id                 Int      @id @default(autoincrement())
