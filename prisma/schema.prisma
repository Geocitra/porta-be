  @@index([reportId])
  @@map("daily_port_report_items")
}

model Warning {
  id            Int           @id @default(autoincrement())
  warningNumber String        @unique @map("warning_number") @db.VarChar(60)
  portId        Int           @map("port_id")
  operatorId    Int           @map("operator_id")
  invoiceId     Int           @map("invoice_id")
  warningLevel  WarningLevel  @map("warning_level")
