// ============================================================================
// MASTER DATA, ONBOARDING & ACCESS CONTROL
// ============================================================================

model Port {
  id                 Int          @id @default(autoincrement())
  code               String       @unique @db.VarChar(20)
  name               String       @db.VarChar(150)
  location           String?      @db.VarChar(200)
  portCategory       PortCategory @default(CAMPURAN) @map("port_category")
  portClassification String       @default("PENGUMPUL") @map("port_classification") @db.VarChar(60)
  isActive           Boolean      @default(true) @map("is_active")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  users            User[]
  berths           Berth[]
  terminals        Terminal[]
  zones            PortZone[]
  facilities       PortFacility[]
  divisionPorts    DivisionPort[]
  assignments      UserAssignment[]
  tasks            Task[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  visits           ShipVisit[]
  dailyPortReports DailyPortReport[]
  warnings         Warning[]
  complaints       Complaint[]
  gateTicketBooks    GateTicketBook[]
  gateHandovers      GateWardenHandover[]
  ferryRoutes        FerryRoute[]
  portAssets         PortAsset[]
  assetLeases        AssetLease[]
  maintenanceTickets MaintenanceTicket[]
  cargoRecords       CargoHandlingRecord[]
  equipmentRentals   EquipmentRentalRecord[]
  utilityReadings    UtilityMeterReading[]
  manifests          VesselManifest[]
  billingAdjustments         BillingAdjustment[]
  paymentGatewayTransactions PaymentGatewayTransaction[]
  berthingContracts          OperatorBerthingContract[]

  @@map("ports")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique @db.VarChar(150)
  username           String?   @unique @db.VarChar(80)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  fullName           String    @map("full_name") @db.VarChar(150)
  role               UserRole
  portId             Int?      @map("port_id")
  divisionId         Int?      @map("division_id")
  operatorId         Int?      @map("operator_id")
  tenantId           Int?      @map("tenant_id")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  port     Port?         @relation(fields: [portId], references: [id], onDelete: Restrict)
  division Division?     @relation("DivisionUsers", fields: [divisionId], references: [id], onDelete: Restrict)
  operator ShipOperator? @relation("OperatorUsers", fields: [operatorId], references: [id], onDelete: Restrict)
  tenant   Tenant?       @relation("TenantUsers", fields: [tenantId], references: [id], onDelete: Restrict)

  verifiedOperators ShipOperator[]   @relation("OperatorVerifiedBy")
  verifiedTenants   Tenant[]         @relation("TenantVerifiedBy")
  verifiedVessels   Vessel[]         @relation("VesselVerifiedBy")
  verifiedOperatorVessels OperatorVessel[] @relation("OperatorVesselVerifiedBy")
  uploadedDocuments Document[]       @relation("DocumentUploadedBy")
  recordedBerthings  BerthingRecord[] @relation("RecordedBy")
  approvedBerthings  BerthingRecord[] @relation("BerthingApprovedBy")
  verifiedPayments  Payment[]         @relation("VerifiedBy")
  auditLogs         AuditLog[]        @relation("Actor")
  dailyPortReports   DailyPortReport[]   @relation("ReportOfficer")
  adminCheckedReports DailyPortReport[]  @relation("ReportAdminChecker")
  headVerifiedReports DailyPortReport[]  @relation("ReportHeadVerifier")
  issuedWarnings     Warning[]           @relation("WarningIssuer")
  notifications      Notification[]
  notificationPreferences NotificationPreference[]
  createdLeases      AssetLease[]        @relation("LeaseCreator")
  verifiedLeasePays  AssetLeasePayment[]   @relation("LeasePaymentVerifier")
  verifiedRoomLeases AssetLease[]          @relation("LeaseRoomVerifiedBy")
  verifiedHeadLeases AssetLease[]          @relation("LeaseHeadVerifiedBy")
  reviewedBerthingContracts OperatorBerthingContract[] @relation("BerthingContractReviewedBy")
  verifiedBerthingContracts OperatorBerthingContract[] @relation("BerthingContractVerifiedBy")
  reportedMaint      MaintenanceTicket[]   @relation("MaintenanceReporter")
  recordedCargos     CargoHandlingRecord[] @relation("CargoRecorder")
  recordedEquipments EquipmentRentalRecord[] @relation("EquipmentRecorder")
  recordedUtilities  UtilityMeterReading[]   @relation("UtilityRecorder")
  recordedManifests  VesselManifest[]        @relation("ManifestRecorder")
  requestedAdjusts           BillingAdjustment[]         @relation("AdjustmentRequester")
  approvedAdjusts            BillingAdjustment[]         @relation("AdjustmentApprover")
  updatedConfigs             SystemConfig[]              @relation("ConfigUpdater")
  gatewayTransactions        PaymentGatewayTransaction[] @relation("GatewayTxCreator")
  assignments                UserAssignment[]            @relation("AssignedUser")
  grantedAssignments         UserAssignment[]            @relation("AssignmentGranter")
  assignedTasks              Task[]                      @relation("TaskAssignee")
  createdTasks               Task[]                      @relation("TaskCreator")
  adminReviewedTasks         Task[]                      @relation("TaskAdminReviewer")
  headVerifiedTasks          Task[]                      @relation("TaskHeadVerifier")
  taskSubmissions            TaskSubmission[]            @relation("TaskSubmitter")
  taskReviews                TaskReview[]                @relation("TaskReviewer")
  taskAttachments            TaskAttachment[]            @relation("TaskAttachmentUploader")
  taskHistories              TaskHistory[]               @relation("TaskHistoryActor")

  @@index([portId])
  @@index([divisionId])
  @@index([operatorId])
  @@index([tenantId])
  @@map("users")
}

model Berth {
  id                      Int                    @id @default(autoincrement())
  portId                  Int                    @map("port_id")
  terminalId              Int?                   @map("terminal_id")
  code                    String                 @db.VarChar(30)
  name                    String                 @db.VarChar(150)
  berthType               BerthType              @map("berth_type")
  berthServiceCategory    BerthServiceCategory   @default(DERMAGA_CAMPURAN) @map("berth_service_category")
  operationalStatus       BerthOperationalStatus @default(OPEN) @map("operational_status")
  authorityType           AuthorityType          @map("authority_type")
  billingEligibility      BillingEligibility     @default(PENDING_VERIFICATION) @map("billing_eligibility")
  legalBasis              String?                @map("legal_basis") @db.VarChar(255)
  managementEvidence      String?                @map("management_evidence") @db.VarChar(255)
  maxLengthMeters         Decimal?               @map("max_length_meters") @db.Decimal(8, 2)
  maxDraftMeters          Decimal?               @map("max_draft_meters") @db.Decimal(6, 2)
  maxGrossTonnage         Decimal?               @map("max_gross_tonnage") @db.Decimal(12, 2)
  allowedVesselCategories VesselCategory[]       @default([]) @map("allowed_vessel_categories")
  allowedShipTypes        ShipType[]             @default([]) @map("allowed_ship_types")
  technicalSpecs          Json?                  @map("technical_specs")
  isActive                Boolean                @default(true) @map("is_active")
  createdAt               DateTime               @default(now()) @map("created_at")
  updatedAt               DateTime               @updatedAt @map("updated_at")

  port               Port                  @relation(fields: [portId], references: [id], onDelete: Restrict)
  terminal           Terminal?             @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  zones              PortZone[]
  facilities         PortFacility[]
  assignments        UserAssignment[]
  tasks              Task[]
  berthingRecords    BerthingRecord[]
  dailyReportItems   DailyPortReportItem[]
  maintenanceTickets MaintenanceTicket[]

  @@unique([portId, code])
  @@unique([portId, id])
  @@index([terminalId])
  @@map("berths")
}

model ShipOperator {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(200)
  npwp               String?            @db.VarChar(50)
  phone              String?            @db.VarChar(50)
  email              String?            @db.VarChar(150)
  address            String?            @db.Text
  operatorProfile    OperatorProfile    @default(REGULAR_SCHEDULED) @map("operator_profile")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  verifiedAt         DateTime?          @map("verified_at")
  verifiedById       Int?               @map("verified_by_id")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  verifiedBy User?      @relation("OperatorVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  users      User[]     @relation("OperatorUsers")
  vessels    Vessel[]
  vesselLinks OperatorVessel[]
  documents  Document[]
  visits     ShipVisit[]
  invoices   Invoice[]
  warnings   Warning[]
  berthingContracts OperatorBerthingContract[]
  assetLeases       AssetLease[]

  @@map("ship_operators")
}

model Tenant {
  id                 Int                @id @default(autoincrement())
  name               String             @db.VarChar(200)
  npwp               String?            @db.VarChar(50)
  nib                String?            @db.VarChar(50)
  phone              String?            @db.VarChar(50)
  email              String?            @db.VarChar(150)
  address            String?            @db.Text
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason    String?            @map("rejection_reason") @db.Text
  verifiedAt         DateTime?          @map("verified_at")
  verifiedById       Int?               @map("verified_by_id")
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  verifiedBy User?        @relation("TenantVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  users      User[]       @relation("TenantUsers")
  documents  Document[]
  leases     AssetLease[]

  @@map("tenants")
}

model Vessel {
  id                  Int                @id @default(autoincrement())
  operatorId          Int?               @map("operator_id")
  registrationNumber  String             @unique @map("registration_number") @db.VarChar(60)
  normalizedRegNumber String             @unique @map("normalized_reg_number") @db.VarChar(80)
  imoNumber           String?            @unique @map("imo_number") @db.VarChar(30)
  normalizedImoNumber String?            @unique @map("normalized_imo_number") @db.VarChar(40)
  name                String             @db.VarChar(150)
  normalizedName      String             @map("normalized_name") @db.VarChar(160)
  flag                String             @default("Indonesia") @db.VarChar(80)
  grossTonnage        Decimal            @map("gross_tonnage") @db.Decimal(12, 2)
  lengthMeters        Decimal?           @map("length_meters") @db.Decimal(8, 2)
  draftMeters         Decimal?           @map("draft_meters") @db.Decimal(6, 2)
  shipType            ShipType           @map("ship_type")
  vesselCategory      VesselCategory     @default(CAMPURAN) @map("vessel_category")
  shippingCategory    ShippingCategory   @map("shipping_category")
  verificationStatus  VerificationStatus @default(PENDING) @map("verification_status")
  rejectionReason     String?            @map("rejection_reason") @db.Text
  verifiedAt          DateTime?          @map("verified_at")
  verifiedById        Int?               @map("verified_by_id")
  isActive            Boolean            @default(true) @map("is_active")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  operator      ShipOperator?    @relation(fields: [operatorId], references: [id], onDelete: SetNull)
  verifiedBy    User?            @relation("VesselVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  operatorLinks OperatorVessel[]
  documents     Document[]
  visits        ShipVisit[]

  @@index([operatorId])
  @@index([normalizedName])
  @@map("vessels")
}

model OperatorVessel {
  id                   Int                    @id @default(autoincrement())
  operatorId           Int                    @map("operator_id")
  vesselId             Int                    @map("vessel_id")
  relationshipType     VesselRelationshipType @default(AGENT) @map("relationship_type")
  verificationStatus   VerificationStatus     @default(PENDING) @map("verification_status")
  rejectionReason      String?                @map("rejection_reason") @db.Text
  authorizationDocPath String?                @map("authorization_doc_path") @db.VarChar(255)
  notes                String?                @db.Text
  verifiedById         Int?                   @map("verified_by_id")
  verifiedAt           DateTime?              @map("verified_at")
  isActive             Boolean                @default(true) @map("is_active")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  operator   ShipOperator @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  vessel     Vessel       @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  verifiedBy User?        @relation("OperatorVesselVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@unique([operatorId, vesselId])
  @@index([vesselId, isActive])
  @@index([operatorId, verificationStatus])
  @@map("operator_vessels")
}

model Document {
  id                 Int                @id @default(autoincrement())
  operatorId         Int?               @map("operator_id")
  tenantId           Int?               @map("tenant_id")
  vesselId           Int?               @map("vessel_id")
  category           DocumentCategory
  documentNumber     String?            @map("document_number") @db.VarChar(100)
  filePath           String             @map("file_path") @db.VarChar(255)
  fileName           String             @map("file_name") @db.VarChar(255)
  mimeType           String             @map("mime_type") @db.VarChar(100)
  uploadedById       Int                @map("uploaded_by_id")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  operator   ShipOperator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  tenant     Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  vessel     Vessel?       @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  uploadedBy User          @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([operatorId])
  @@index([tenantId])
  @@index([vesselId])
  @@map("documents")
}

// ============================================================================
// TARIFF MATRIX (Perda Kab. Mimika No. 4 Tahun 2023)
// ============================================================================

model PortTariff {
  id               Int              @id @default(autoincrement())
  tariffCode       String           @unique @map("tariff_code") @db.VarChar(60)
  serviceCode      ServiceCode      @map("service_code")
  shippingCategory ShippingCategory @map("shipping_category")
  shipType         ShipType?        @map("ship_type")
  activityMode     ActivityMode?    @map("activity_mode")
  berthType        BerthType?       @map("berth_type")
  unitType         TariffUnitType   @map("unit_type")
  currency         Currency         @default(IDR)
  amount           Decimal          @db.Decimal(14, 4)
  legalBasis       String           @map("legal_basis") @db.VarChar(255)
  effectiveFrom    DateTime         @map("effective_from")
  effectiveTo      DateTime?        @map("effective_to")
  isActive         Boolean          @default(true) @map("is_active")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  invoiceItems InvoiceItem[]

  @@index([serviceCode, shippingCategory, isActive])
  @@map("port_tariffs")
}

// ============================================================================
// PORT OPERATIONS (Vessel Visits & Berthing Realization)
// ============================================================================

model ShipVisit {
  id                 Int               @id @default(autoincrement())
  visitNumber        String            @unique @map("visit_number") @db.VarChar(50)
  portId             Int               @map("port_id")
  vesselId           Int               @map("vessel_id")
  operatorId         Int               @map("operator_id")
  berthingContractId Int?              @map("berthing_contract_id")
  visitOrigin        VisitOrigin       @default(OPERATOR_REQUEST) @map("visit_origin")
  activityMode       VisitActivityMode @default(NORMAL) @map("activity_mode")
  isTransitOnly      Boolean           @default(false) @map("is_transit_only")
  originPort         String?           @map("origin_port") @db.VarChar(150)
  destinationPort    String?           @map("destination_port") @db.VarChar(150)
  eta                DateTime
  etd                DateTime
  ataAnchorage       DateTime?         @map("ata_anchorage")
  atdPort            DateTime?         @map("atd_port")
  status             VisitStatus       @default(REQUESTED)
  notes              String?           @db.Text
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  port             Port                      @relation(fields: [portId], references: [id], onDelete: Restrict)
  vessel           Vessel                    @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  operator         ShipOperator              @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  berthingContract OperatorBerthingContract? @relation(fields: [berthingContractId], references: [id], onDelete: Restrict)
  berthingRecords  BerthingRecord[]
  invoices         Invoice[]
  dailyReportItems DailyPortReportItem[]
  cargoRecords     CargoHandlingRecord[]
  equipmentRentals EquipmentRentalRecord[]
  utilityReadings  UtilityMeterReading[]
  manifests        VesselManifest[]
  tasks            Task[]

  @@unique([portId, id])
  @@index([portId, status])
  @@index([operatorId])
  @@index([berthingContractId])
  @@map("ship_visits")
}

model BerthingRecord {
