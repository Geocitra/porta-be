  port     Port      @relation(fields: [portId], references: [id], onDelete: Restrict)
  terminal Terminal? @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  berth    Berth?    @relation(fields: [berthId], references: [id], onDelete: Restrict)
  zone     PortZone? @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  @@unique([portId, code])
  @@index([portId, conditionStatus])
  @@map("port_facilities")
}

model UserAssignment {
  id              Int              @id @default(autoincrement())
  assignmentCode  String           @unique @map("assignment_code") @db.VarChar(60)
  userId          Int              @map("user_id")
  role            UserRole
  portId          Int              @map("port_id")
  terminalId      Int?             @map("terminal_id")
  berthId         Int?             @map("berth_id")
  zoneId          Int?             @map("zone_id")
  taskTypes       TaskType[]       @default([]) @map("task_types")
  permissionCodes String[]         @default([]) @map("permission_codes")
  startDate       DateTime         @map("start_date")
  endDate         DateTime?        @map("end_date")
  status          AssignmentStatus @default(ACTIVE)
  assignedById    Int              @map("assigned_by_id")
