  terminal    Terminal?        @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  berth       Berth?           @relation(fields: [berthId], references: [id], onDelete: Restrict)
  facilities  PortFacility[]
  assignments UserAssignment[]
