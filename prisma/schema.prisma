  utilityReadings    UtilityMeterReading[]

  @@unique([portId, id])
  @@index([portId, status])
  @@map("port_assets")
}

model AssetLease {
  id                      Int         @id @default(autoincrement())
  contractNumber          String      @unique @map("contract_number") @db.VarChar(60)
  portId                  Int         @map("port_id")
  assetId                 Int         @map("asset_id")
  tenantId                Int?        @map("tenant_id")
  operatorId              Int?        @map("operator_id")
  tenantName              String      @map("tenant_name") @db.VarChar(150)
  tenantNpwp              String?     @map("tenant_npwp") @db.VarChar(50)
  tenantPhone             String?     @map("tenant_phone") @db.VarChar(50)
  startDate               DateTime    @map("start_date") @db.Date
  endDate                 DateTime    @map("end_date") @db.Date
  totalAnnualAmountIdr    Decimal     @map("total_annual_amount_idr") @db.Decimal(16, 2)
  status                  LeaseStatus @default(DRAFT)
  rejectionReason         String?     @map("rejection_reason") @db.Text
  verifiedByRoomOfficerId Int?        @map("verified_by_room_officer_id")
  verifiedByRoomOfficerAt DateTime?   @map("verified_by_room_officer_at")
  verifiedByHeadOfPortId  Int?        @map("verified_by_head_of_port_id")
  verifiedByHeadOfPortAt  DateTime?   @map("verified_by_head_of_port_at")
  createdById             Int         @map("created_by_id")
  createdAt               DateTime    @default(now()) @map("created_at")
  updatedAt               DateTime    @updatedAt @map("updated_at")

  port                  Port          @relation(fields: [portId], references: [id], onDelete: Restrict)
  asset                 PortAsset     @relation(fields: [portId, assetId], references: [portId, id], onDelete: Restrict)
  tenant                Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  operator              ShipOperator? @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  createdBy             User          @relation("LeaseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedByRoomOfficer User?         @relation("LeaseRoomVerifiedBy", fields: [verifiedByRoomOfficerId], references: [id], onDelete: Restrict)
  verifiedByHeadOfPort  User?         @relation("LeaseHeadVerifiedBy", fields: [verifiedByHeadOfPortId], references: [id], onDelete: Restrict)
  payments              AssetLeasePayment[]

  @@index([portId, status])
  @@index([tenantId])
  @@index([operatorId])
  @@map("asset_leases")
}

