model Notification {
  id           Int                  @id @default(autoincrement())
  userId       Int                  @map("user_id")
  portId       Int?                 @map("port_id")
  title        String               @db.VarChar(200)
  message      String               @db.Text
  type         String               @db.VarChar(50)
  category     String               @default("GENERAL") @db.VarChar(60)
