  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  task          Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission    TaskSubmission?    @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  checklistItem TaskChecklistItem? @relation(fields: [checklistItemId], references: [id], onDelete: SetNull)
  uploadedBy    User               @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([checklistItemId])
  @@map("task_attachments")
}

model TaskSubmission {
  id                Int      @id @default(autoincrement())
  taskId            Int      @map("task_id")
  submissionNumber  Int      @map("submission_number")
  submittedById     Int      @map("submitted_by_id")
  notes             String?  @db.Text
  checklistSnapshot Json?    @map("checklist_snapshot")
  submittedAt       DateTime @default(now()) @map("submitted_at")

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedBy User             @relation("TaskSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  attachments TaskAttachment[]
  reviews     TaskReview[]

  @@unique([taskId, submissionNumber])
  @@index([taskId])
  @@map("task_submissions")
}

model TaskReview {
  id           Int             @id @default(autoincrement())
  taskId       Int             @map("task_id")
  submissionId Int?            @map("submission_id")
  reviewStage  TaskReviewStage @map("review_stage")
  reviewerId   Int             @map("reviewer_id")
  reviewerRole UserRole        @map("reviewer_role")
  decision     String          @db.VarChar(40)
  notes        String?         @db.Text
  reason       String?         @db.Text
  evidencePath String?         @map("evidence_path") @db.VarChar(255)
  createdAt    DateTime        @default(now()) @map("created_at")

  task       Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submission TaskSubmission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  reviewer   User            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([taskId, reviewStage])
  @@index([reviewerId])
  @@map("task_reviews")
}

model TaskHistory {
  id                  Int                  @id @default(autoincrement())
  taskId              Int                  @map("task_id")
  actorId             Int?                 @map("actor_id")
  actorRole           UserRole?            @map("actor_role")
  action              String               @db.VarChar(80)
  fromExecutionStatus TaskExecutionStatus? @map("from_execution_status")
  toExecutionStatus   TaskExecutionStatus? @map("to_execution_status")
  fromReviewStatus    TaskReviewStatus?    @map("from_review_status")
  toReviewStatus      TaskReviewStatus?    @map("to_review_status")
  notes               String?              @db.Text
  reason              String?              @db.Text
  evidencePath        String?              @map("evidence_path") @db.VarChar(255)
  createdAt           DateTime             @default(now()) @map("created_at")

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User? @relation("TaskHistoryActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
  @@map("task_histories")
}

model NotificationPreference {
  id           Int                  @id @default(autoincrement())
  userId       Int                  @map("user_id")
  category     String               @db.VarChar(60)
  minPriority  NotificationPriority @default(INFORMATIONAL) @map("min_priority")
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

