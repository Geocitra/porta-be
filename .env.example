PORT=4000
NODE_ENV=development

# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/porta_db?schema=public"

# JWT Auth
JWT_SECRET="change-this-to-a-strong-random-secret-in-production"
JWT_EXPIRES_IN="1d"

# Billing & Tariff Rules (Perda Mimika 4/2023)
# ROUND_UP: ceil(hours / 24), HALF_DAY_GRACE: <=12h = 0.5 etmal, >12h = 1 etmal
ETMAL_ROUNDING_MODE="ROUND_UP"
DEFAULT_USD_TO_IDR_RATE=16000
BANK_WEBHOOK_SECRET="change-this-bank-webhook-hmac-secret"

